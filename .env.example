# Copy to .env and fill in. Never commit .env.
# GHL > Sub-Account Settings > Private Integrations > Create new integration.
# Scopes: contacts.write, contacts.readonly, opportunities.write, opportunities.readonly,
#         locations/customFields.write, locations/customFields.readonly,
#         locations/tags.write, locations/tags.readonly,
#         locations/customValues.write, locations/customValues.readonly
GHL_PRIVATE_TOKEN=
# GHL > Sub-Account Settings > Business Profile (Location ID is shown there and in the URL)
GHL_LOCATION_ID=
