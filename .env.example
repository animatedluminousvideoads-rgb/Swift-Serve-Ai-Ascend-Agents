# Copy to .env for local runs (never commit .env). In production these are
# GitHub Actions secrets: Settings > Secrets and variables > Actions.

# Required
GHL_API_TOKEN=            # GHL sub-account Private Integration token
GHL_LOCATION_ID=          # GHL sub-account (location) ID
GOOGLE_PLACES_API_KEY=    # Google Cloud key with "Places API (New)" enabled

# Recommended
ANTHROPIC_API_KEY=        # Claude writes site copy + classifies call outcomes (templates/keywords without it)
TWILIO_ACCOUNT_SID=       # Twilio Lookup line-type check; without it no lead is auto-called
TWILIO_AUTH_TOKEN=

# Optional
ASCEND_SUPPRESS_NUMBERS=  # comma-separated E.164 numbers never to call, e.g. +16025550143,+13055550100
ASCEND_TEST_PHONE=        # your own cell, for `ascend test-call`
ASCEND_SITE_BASE_URL=     # override where demo sites are served (e.g. a custom domain)
ASCEND_CLAUDE_MODEL=      # default: claude-opus-5-5
ASCEND_DRY_RUN=           # "true" = build preview sites only, no GHL writes
